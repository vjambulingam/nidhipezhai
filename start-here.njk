    <!-- ================= STAGE 2: INTERMEDIATE ================= -->
    <section class="roadmap-stage" id="stage-intermediate" aria-labelledby="heading-intermediate">
      <div class="roadmap-stage__header">
        <div class="roadmap-stage__badge roadmap-stage__badge--intermediate">படிநிலை 2 · இடைநிலை</div>
        <h2 id="heading-intermediate">வளர்ச்சி & சொத்து உருவாக்கம் (Growth & Wealth Accumulation)</h2>
        <p class="roadmap-stage__summary">அடித்தளம் உறுதியானதும், பணவீக்கத்தை (Inflation) வென்று நீண்டகாலச் சொத்தை உருவாக்க பங்குச் சந்தை மற்றும் மியூச்சுவல் ஃபண்ட் முதலீடுகளைத் தொடங்குங்கள்.</p>
      </div>

      <div class="roadmap-grid">
        <!-- Step 2.1 -->
        <article class="roadmap-card">
          <div class="roadmap-card__top">
            <span class="roadmap-card__step">படி 2.1</span>
            <span class="roadmap-card__tag">முதலீட்டு அடிப்படைகள்</span>
          </div>
          <h3>பணவீக்கத்தைப் புரிந்துகொண்டு இலக்கு நிர்ணயித்தல்</h3>
          <p>பணத்தின் வாங்கும் சக்தி காலப்போக்கில் குறைவதைக் கணித்து, பிள்ளைகளின் கல்வி, திருமணம், ஓய்வூதியம் போன்ற காலக்கெடுவுக்கு ஏற்ப சொத்துகளைப் (Asset Allocation) பிரியுங்கள்.</p>
          <div class="roadmap-card__resources">
            <span class="roadmap-card__res-label">பரிந்துரைக்கப்படும் வளங்கள்:</span>
