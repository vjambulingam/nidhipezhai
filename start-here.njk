    <!-- ================= STAGE 1: BEGINNER ================= -->
    <section class="roadmap-stage" id="stage-beginner" aria-labelledby="heading-beginner">
      <div class="roadmap-stage__header">
        <div class="roadmap-stage__badge roadmap-stage__badge--beginner">படிநிலை 1 · தொடக்க நிலை</div>
        <h2 id="heading-beginner">அடித்தளம் & குடும்பப் பாதுகாப்பு (Foundation & Protection)</h2>
        <p class="roadmap-stage__summary">முதலீடு தொடங்குவதற்கு முன் உங்கள் வருமானமும் குடும்பமும் எதிர்பாராத நிதிப் பேரழிவுகளில் இருந்து பாதுகாக்கப்பட வேண்டும். கடனை அடைத்து, அவசர நிதியை அமைப்பதே முதல் படி.</p>
      </div>

      <div class="roadmap-grid">
        <!-- Step 1.1 -->
        <article class="roadmap-card">
          <div class="roadmap-card__top">
            <span class="roadmap-card__step">படி 1.1</span>
            <span class="roadmap-card__tag">அவசர கால நிதி</span>
          </div>
          <h3>குறைந்தபட்சம் 6 மாத அவசர நிதியை அமைத்தல்</h3>
          <p>வேலையிழப்பு, மருத்துவ அவசரம் போன்றவற்றிற்கு 6 முதல் 12 மாத அத்தியாவசியக் குடும்பச் செலவை எளிதில் எடுக்கக்கூடிய சேமிப்புக் கணக்கு அல்லது லிக்விட் ஃபண்டில் சேமிக்க வேண்டும்.</p>
          <div class="roadmap-card__resources">
            <span class="roadmap-card__res-label">பரிந்துரைக்கப்படும் வளங்கள்:</span>
            <ul class="roadmap-card__res-list">
              <li>
                <span class="res-type res-type--article">கட்டுரை</span>
                <a href="{{ '/articles/in-case-of-emergency-kit/' | url }}">குடும்ப அவசர ஆவணப் பெட்டகம் (ICE Kit) ↗</a>
              </li>
              <li>
                <span class="res-type res-type--calculator">கணிப்பேடு</span>
                <a href="{{ '/calculators/emergency-fund-planner.html' | url }}">அவசர நிதித் திட்டமிடுபவர் ↗</a>
              </li>
              <li>
                <span class="res-type res-type--checklist">பட்டியல்</span>
                <a href="{{ '/checklists/icoe-checklist.html' | url }}">குடும்ப அவசர ஆவணங்கள் சரிபார்ப்புப் பட்டியல் ↗</a>
              </li>
            </ul>
          </div>
        </article>

        <!-- Step 1.2 -->
        <article class="roadmap-card">
          <div class="roadmap-card__top">
            <span class="roadmap-card__step">படி 1.2</span>
            <span class="roadmap-card__tag">கடன் மேலாண்மை</span>
          </div>
          <h3>அதிக வட்டிக் கடன்களை ஒழித்தல் & கிரெடிட் ஸ்கோர்</h3>
          <p>கிரெடிட் கார்டு நிலுவை (36%–42% வட்டி) மற்றும் தனிநபர் கடன்களை உடனடியாக அடைக்க வேண்டும். முறையான கடன் திருப்பிச் செலுத்துதல் மூலம் கிரெடிட் ஸ்கோரை 750+ ஆக உயர்த்த வேண்டும்.</p>
          <div class="roadmap-card__resources">
            <span class="roadmap-card__res-label">பரிந்துரைக்கப்படும் வளங்கள்:</span>
            <ul class="roadmap-card__res-list">
              <li>
                <span class="res-type res-type--article">கட்டுரை</span>
                <a href="{{ '/articles/credit-card-optimization-and-traps/' | url }}">கிரெடிட் கார்டு உத்திகளும் பொறிகளும் ↗</a>
              </li>
              <li>
                <span class="res-type res-type--article">கட்டுரை</span>
                <a href="{{ '/articles/credit-score/' | url }}">கிரெடிட் ஸ்கோர் விழிப்புணர்வு ↗</a>
              </li>
              <li>
                <span class="res-type res-type--calculator">கணிப்பேடு</span>
                <a href="{{ '/calculators/credit-card-payoff-calculator.html' | url }}">கிரெடிட் கார்டு கடன் தீர்வு கணிப்பேடு ↗</a>
              </li>
            </ul>
          </div>
        </article>

        <!-- Step 1.3 -->
        <article class="roadmap-card">
          <div class="roadmap-card__top">
            <span class="roadmap-card__step">படி 1.3</span>
            <span class="roadmap-card__tag">தூய காப்பீடு</span>
          </div>
          <h3>டேர்ம் இன்சூரன்ஸ் & விரிவான மருத்துவக் காப்பீடு</h3>
          <p>முதலீட்டையும் இன்சூரன்ஸையும் பிரிக்கவும் (LIC எண்டோவ்மென்ட் தவிர்க்கவும்). ஆண்டு வருமானத்தைப் போல 15–20 மடங்கு தூய டேர்ம் இன்சூரன்ஸ் மற்றும் குடும்பத்திற்கு ஃபேமிலி ஃப்ளோட்டர் ஹெல்த் இன்சூரன்ஸ் கட்டாயம் தேவை.</p>
          <div class="roadmap-card__resources">
            <span class="roadmap-card__res-label">பரிந்துரைக்கப்படும் வளங்கள்:</span>
