<!DOCTYPE html>
<html lang="{{ site.language }}">
<head>
  {% set canonicalUrl = page.url | url | absoluteUrl %}
  {% set socialTitle = ogTitle or (title + " · " + site.title) %}
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}">
  <meta name="keywords" content="{{ keywords }}">
  <meta name="robots" content="index,follow,max-image-preview:large">
  <meta name="theme-color" content="#0D7377">
  <link rel="canonical" href="{{ canonicalUrl }}">
  <link rel="icon" type="image/svg+xml" href="{{ '/assets/images/nidhipezhai-logo.svg' | url }}">
  <meta property="og:type" content="website">
  <meta property="og:locale" content="ta_IN">
  <meta property="og:site_name" content="{{ site.title }}">
  <meta property="og:title" content="{{ socialTitle }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:url" content="{{ canonicalUrl }}">
  {% set calcOgImage = ogImage or ('/assets/images/og/calculators/' + page.fileSlug + '.png') %}
  <meta property="og:image" content="{{ calcOgImage | url | absoluteUrl }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ socialTitle }}">
  <meta name="twitter:description" content="{{ description }}">
  <meta name="twitter:image" content="{{ calcOgImage | url | absoluteUrl }}">
  <link rel="alternate" type="application/atom+xml" title="{{ site.title }}" href="{{ '/feed.xml' | url | absoluteUrl }}">
  <script data-goatcounter="https://nidhipezhai.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Noto+Sans+Tamil:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="{{ '/assets/css/tailwind.css' | url }}">
  <link rel="stylesheet" href="{{ '/assets/css/site.css' | url }}">
  <link rel="stylesheet" href="{{ '/assets/css/calculator-theme.css' | url }}">
  {% if hasChart %}
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  {% endif %}
  {% if siteOrigin %}
  {% set appSchema = {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": title,
    "description": description,
    "inLanguage": "ta-IN",
    "applicationCategory": "FinanceApplication",
    "operatingSystem": "Web",
    "url": canonicalUrl,
    "publisher": {
      "@type": "Organization",
      "name": site.title,
      "url": siteOrigin
    }
  } %}
  <script type="application/ld+json">{{ appSchema | jsonify | safe }}</script>
  {% endif %}
  {% include "partials/theme-init.njk" %}
</head>
<body class="min-h-screen flex flex-col justify-between antialiased">
  <a class="skip-link" href="#main-content">முதன்மை உள்ளடக்கத்திற்குத் தாவவும்</a>
  {% include "partials/site-header.njk" %}
  <div class="calc-toolbar no-print">
    <div class="wrap calc-toolbar__inner">
          {% set calcCategory = "" %}
          {% set calcGroupId = "" %}
          {% set nextCalc = null %}
          {% for group in calculators %}
            {% set groupIndex = loop.index %}
            {% for item in group.items %}
              {% if item.url == page.url %}
                {% set calcCategory = group.category %}
                {% set calcGroupId = groupIndex %}
                {% set nextCalc = group.items[(loop.index0 + 1) % group.items | length] %}
              {% endif %}
            {% endfor %}
          {% endfor %}
          <nav class="calc-breadcrumbs" aria-label="நீங்கள் இருக்கும் இடம்">
            <a href="{{ '/' | url }}">முகப்பு</a>
            <span aria-hidden="true">/</span>
            <a href="{{ '/calculators/' | url }}">கணிப்பேடுகள்</a>
            {% if calcCategory %}
            <span aria-hidden="true">/</span>
            <a href="{{ '/calculators/' | url }}#calculator-group-{{ calcGroupId }}">{{ calcCategory }}</a>
            {% endif %}
            <span aria-hidden="true">/</span>
            <span aria-current="page">{{ title }}</span>
          </nav>
    </div>
  </div>
  <div class="calc-toolbar calc-toolbar--actions no-print">
    <div class="wrap calc-toolbar__inner">
          {% set shareVariant = "icons-only" %}
          {% include "partials/social-share.njk" %}
          <button id="btnHeaderReset" type="button" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-gray-700 bg-gray-100 hover:bg-gray-200 rounded-lg transition-colors" title="இயல்புநிலைக்கு மீட்டமைக்க">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
            <span>மீட்டமை</span>
          </button>
          <button id="btnPrint" type="button" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-gray-700 bg-gray-100 hover:bg-gray-200 rounded-lg transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4H7v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg>
            அச்சிடு
          </button>
          {% if hasCsvExport != false %}
          <button id="btnExportCSV" type="button" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-white bg-sky-600 hover:bg-sky-700 rounded-lg shadow-sm transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
            <span>Excel பதிவிறக்கம்</span>
          </button>
          {% endif %}
          {% if nextCalc %}
          <a class="calc-toolbar__next" href="{{ nextCalc.url | url }}" title="அடுத்த கணிப்பேடு: {{ nextCalc.title }}">
            <span class="calc-toolbar__next-label">அடுத்த கணிப்பேடு:</span>
            <span class="calc-toolbar__next-title">{{ nextCalc.title }}</span> &rarr;
          </a>
          {% endif %}
    </div>
  </div>

  <script src="{{ '/assets/js/calculator-utils.js' | url }}"></script>
  {{ content | safe }}

  {% if nextCalc %}
  <nav class="calc-next no-print" aria-label="அடுத்த கணிப்பேடு">
    <div class="wrap calc-next__inner">
      <a class="calc-next__all" href="{{ '/calculators/' | url }}#calculator-group-{{ calcGroupId }}">&larr; எல்லாக் கணிப்பேடுகளும்</a>
      <a class="calc-next__link" href="{{ nextCalc.url | url }}">
        <span class="calc-next__label">அடுத்த கணிப்பேடு · {{ calcCategory }}</span>
        <span class="calc-next__title">{{ nextCalc.title }} &rarr;</span>
      </a>
    </div>
  </nav>
  {% endif %}

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-10 no-print">
    {% set shareVariant = "box" %}
    {% set shareContext = "calculator" %}
    {% include "partials/social-share.njk" %}
  </div>

  {% include "partials/site-footer.njk" %}
  <script src="{{ '/assets/js/theme.js' | url }}" defer></script>
</body>
</html>

