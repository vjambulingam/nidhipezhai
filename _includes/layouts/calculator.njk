<!DOCTYPE html>
<html lang="{{ site.language }}">
<head>
  {% set canonicalUrl = page.url | url | absoluteUrl %}
  {% set socialTitle = ogTitle or (title + " · " + site.title) %}
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}">
  <meta name="keywords" content="{{ keywords }}">
  <meta name="robots" content="index,follow,max-image-preview:large">
  <meta name="theme-color" content="#0D7377">
  <link rel="canonical" href="{{ canonicalUrl }}">
  <link rel="icon" type="image/svg+xml" href="{{ '/assets/images/nidhipezhai-logo.svg' | url }}">
  <meta property="og:type" content="website">
  <meta property="og:locale" content="ta_IN">
  <meta property="og:site_name" content="{{ site.title }}">
  <meta property="og:title" content="{{ socialTitle }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:url" content="{{ canonicalUrl }}">
  <meta property="og:image" content="{{ '/assets/images/nidhipezhai-og.png' | url | absoluteUrl }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ socialTitle }}">
  <meta name="twitter:description" content="{{ description }}">
  <meta name="twitter:image" content="{{ '/assets/images/nidhipezhai-og.png' | url | absoluteUrl }}">
  <link rel="alternate" type="application/atom+xml" title="{{ site.title }}" href="{{ '/feed.xml' | url | absoluteUrl }}">
  <script data-goatcounter="https://nidhipezhai.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Noto+Sans+Tamil:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="{{ '/assets/css/tailwind.css' | url }}">
  <link rel="stylesheet" href="{{ '/assets/css/calculator-theme.css' | url }}">
  {% if hasChart %}
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  {% endif %}
  {% if siteOrigin %}
  {% set appSchema = {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": title,
    "description": description,
    "inLanguage": "ta-IN",
    "applicationCategory": "FinanceApplication",
    "operatingSystem": "Web",
    "url": canonicalUrl,
    "publisher": {
      "@type": "Organization",
      "name": site.title,
      "url": siteOrigin
    }
  } %}
  <script type="application/ld+json">{{ appSchema | jsonify | safe }}</script>
  {% endif %}
</head>
<body class="min-h-screen flex flex-col justify-between antialiased">
  <header class="bg-white border-b border-gray-200 sticky top-0 z-50 shadow-xs">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="calc-site-header__inner flex items-center justify-between h-16">
        <div class="calc-site-header__identity flex items-center space-x-3">
          <a class="calc-site-logo" href="{{ '/index.html' | url }}" aria-label="{{ site.title }} முகப்பு"><img src="{{ '/assets/images/nidhipezhai-logo.svg' | url }}" alt=""></a>
          <div>
            <p class="text-xl font-bold tracking-tight text-gray-900 leading-tight">{{ site.title }}</p>
            <p class="text-xs text-gray-500 font-medium hidden sm:block">{{ site.tagline }}</p>
          </div>
        </div>
        <nav class="calc-site-header__nav" aria-label="முதன்மை வழிசெலுத்தல்">
          <a class="calc-nav-articles" href="{{ '/index.html#articles' | url }}">கட்டுரைகள்</a>
          <a class="calc-nav-directory" href="{{ '/calculators/index.html' | url }}">கணிப்பேடுகள்</a>
          <a class="calc-nav-checklists" href="{{ '/checklists/' | url }}">சரிபார்ப்புப் பட்டியல்கள்</a>
        </nav>
        <div class="calc-site-header__actions flex items-center space-x-2 no-print">
          <button id="btnPrint" type="button" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-gray-700 bg-gray-100 hover:bg-gray-200 rounded-lg transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4H7v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg>
            அச்சிடு
          </button>
          {% if hasCsvExport != false %}
          <button id="btnExportCSV" type="button" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-white bg-sky-600 hover:bg-sky-700 rounded-lg shadow-sm transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
            {{ csvButtonLabel or "CSV ஏற்றுமதி" }}
          </button>
          {% endif %}
        </div>
      </div>
    </div>
  </header>

  <script src="{{ '/assets/js/calculator-utils.js' | url }}"></script>
  {{ content | safe }}

  <footer class="calc-site-footer bg-white border-t border-gray-200 mt-10 py-6 text-center text-xs text-gray-500">
    <div class="calc-site-footer__inner max-w-7xl mx-auto px-4">
      <div class="calc-site-footer__main">
        <div>
          <a class="calc-site-footer__brand" href="{{ '/index.html' | url }}">{{ site.title }}</a>
          <p class="calc-site-footer__tagline">{{ site.tagline }}.</p>
        </div>
        <nav class="calc-site-footer__links" aria-label="தள இணைப்புகள்">
          <a href="{{ '/about/' | url }}">எங்களைப் பற்றி</a>
          <a href="{{ '/disclaimer/' | url }}">பொறுப்புத் துறப்பு</a>
          <a href="{{ '/license/' | url }}">உரிமம்</a>
        </nav>
      </div>
      <p class="font-medium text-gray-600">{{ footerTitle or title }}</p>
      {% if footerNote %}
      <p class="mt-1 text-gray-400">{{ footerNote }}</p>
      {% endif %}
      <p class="mt-2 text-gray-500">பொறுப்புத் துறப்பு: இந்தக் கணிப்பேடு கல்வி மற்றும் விழிப்புணர்வு நோக்கத்திற்காக மட்டுமே. காட்டப்படும் கணக்கீடுகளின் துல்லியம் அல்லது முழுமைக்கு உத்தரவாதம் அளிக்கப்படாது; அவற்றின் அடிப்படையில் எடுக்கப்படும் முடிவுகள் அல்லது ஏற்படும் இழப்புகளுக்கு நாங்கள் பொறுப்பேற்க மாட்டோம். முதலீடு அல்லது கடன் முடிவெடுப்பதற்கு முன் <a href="{{ '/articles/sebi-registered-investment-advisors/' | url }}">தகுதியான நிதி ஆலோசகரை அணுகவும்</a>.</p>
      <p class="calc-site-footer__license">இந்தத் தளத்தின் உள்ளடக்கம் <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/">CC BY-NC-SA 4.0</a> உரிமத்தின் கீழ் பகிரப்படுகிறது.</p>
    </div>
  </footer>
</body>
</html>

